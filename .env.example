# Copy this file to ".env" and fill in your real keys. ".env" is gitignored.
#
# Twitch app (free): https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
#
# Google / Gemini key (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
#
# Optional: ElevenLabs voice key for the AI story generator (agent.py)
ELEVENLABS_API_KEY=
#
# Optional: set true to pull YouTube/Rumble sources (requires local browser cookies)
USE_YOUTUBE=false
